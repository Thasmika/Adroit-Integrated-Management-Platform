# ---- copy to .env and fill in; never commit .env ----
APP_VERSION=1.0.0
# public name of the server (DNS A record -> server IP)
DOMAIN=hr.adroit.ae
# for HTTPS certificate notices
ACME_EMAIL=it@adroit.ae
TZ=Asia/Dubai

# database (used by db, app and backup services)
POSTGRES_DB=adroit
POSTGRES_USER=adroit
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# first administrator (created on the first start only; must change password at first sign-in)
ADMIN_EMAIL=it.admin@adroit.ae
ADMIN_NAME=System Administrator
# leave empty to print a generated temporary password in the app log
ADMIN_PASSWORD=

# sessions & security
SESSION_HOURS=10
# sign-in attempts per minute per IP
LOGIN_RATE_LIMIT=10

# e-mail alerts (optional; in-app alerts always work). Turn e-mail on in Administration after verifying.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Adroit Platform <no-reply@adroit.ae>

# background jobs (cron syntax, in TZ)
EXPIRY_CRON=5 0 * * *
DIGEST_CRON=0 7 * * *
MAIL_CRON=*/5 * * * *

# AI assistant (optional). Without a key the built-in rules engine answers and nothing leaves the server.
# none | anthropic
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
AI_TIMEOUT_MS=8000

# backups (backup service)
BACKUP_TIME=02:30
BACKUP_KEEP_DAYS=30

# AWS Configuration (For Database Backups)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_S3_BACKUP_BUCKET=adroit-database-backups-bucket

LOG_LEVEL=info
