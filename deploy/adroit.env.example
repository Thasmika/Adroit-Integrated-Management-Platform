# /etc/adroit/adroit.env for Option B (systemd). Same settings as deploy/.env.example, plus the database URL.
DATABASE_URL=postgres://adroit:change-me@127.0.0.1:5432/adroit
FILES_DIR=/var/lib/adroit/files
BACKUP_DIR=/var/backups/adroit
PORT=3000
HOST=127.0.0.1
PUBLIC_URL=https://hr.adroit.ae
COOKIE_SECURE=true
TRUST_PROXY=true
TZ=Asia/Dubai
ADMIN_EMAIL=it.admin@adroit.ae
ADMIN_NAME=System Administrator
ADMIN_PASSWORD=
SESSION_HOURS=10
LOGIN_RATE_LIMIT=10
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Adroit Platform <no-reply@adroit.ae>
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
LOG_LEVEL=info
