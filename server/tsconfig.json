  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": false, "noImplicitAny": false, "esModuleInterop": true, "skipLibCheck": true,
    "allowJs": true, "checkJs": false, "resolveJsonModule": true, "noEmit": true, "types": ["node"]
  },
  "include": ["src", "test"]
}
