{
  "name": "@adroit/server", "version": "1.0.0", "private": true, "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts src/cli.ts --bundle --platform=node --format=esm --target=node20 --outdir=dist --packages=external --out-extension:.js=.mjs",
    "start": "node dist/index.mjs",
    "migrate": "tsx src/cli.ts migrate",
    "seed": "tsx src/cli.ts seed",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@adroit/core": "1.0.0",
    "@fastify/cookie": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^8.0.3",
    "bcryptjs": "^2.4.3",
    "csv-parse": "^5.6.0",
    "fastify": "^5.2.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
